<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Nút ===== -->
    <!-- Nút chính (nền đặc). Là style mặc định của mọi Button trong app. -->
    <style name="Widget.QLPT.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Nút chính cỡ lớn cho hành động chính của màn (cao 52dp) -->
    <style name="Widget.QLPT.Button.Large">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Nút nổi bật màu cam (vd: Báo sự cố) -->
    <style name="Widget.QLPT.Button.Accent">
        <item name="backgroundTint">@color/qlpt_accent</item>
        <item name="android:textColor">@color/qlpt_surface</item>
    </style>

    <!-- Nút viền -->
    <style name="Widget.QLPT.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/qlpt_border</item>
    </style>

    <!-- Nút chữ -->
    <style name="Widget.QLPT.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ===== Thẻ phẳng viền mảnh ===== -->
    <style name="Widget.QLPT.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/qlpt_border</item>
        <item name="cardBackgroundColor">@color/qlpt_surface</item>
    </style>

    <!-- ===== Spinner (vẫn là Spinner, chỉ đổi nền) ===== -->
    <style name="Widget.QLPT.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
    </style>

    <!-- ===== Chip ===== -->
    <style name="Widget.QLPT.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">8dp</item>
    </style>

    <style name="Widget.QLPT.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">8dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- ===== Badge trạng thái (dùng cho TextView) ===== -->
    <style name="Widget.QLPT.Badge" parent="">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_status_neutral</item>
        <item name="android:textColor">@color/qlpt_text_secondary</item>
    </style>

    <style name="Widget.QLPT.Badge.Neutral" />

    <style name="Widget.QLPT.Badge.Primary">
        <item name="android:background">@drawable/bg_status_primary</item>
        <item name="android:textColor">@color/qlpt_on_primary_container</item>
    </style>

    <style name="Widget.QLPT.Badge.Success">
        <item name="android:background">@drawable/bg_status_success</item>
        <item name="android:textColor">@color/qlpt_success</item>
    </style>

    <style name="Widget.QLPT.Badge.Warning">
        <item name="android:background">@drawable/bg_status_warning</item>
        <item name="android:textColor">@color/qlpt_warning</item>
    </style>

    <style name="Widget.QLPT.Badge.Error">
        <item name="android:background">@drawable/bg_status_error</item>
        <item name="android:textColor">@color/qlpt_error</item>
    </style>

    <!-- ===== Thanh điều hướng dưới ===== -->
    <style name="Widget.QLPT.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/qlpt_surface</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ===== Bottom sheet bo 24dp hai góc trên ===== -->
    <style name="ThemeOverlay.QLPT.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.QLPT.BottomSheet</item>
    </style>

    <style name="Widget.QLPT.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/qlpt_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.QLPT.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.QLPT.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===== Thang chữ ===== -->
    <!-- Tiêu đề màn hình -->
    <style name="TextAppearance.QLPT.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/qlpt_text</item>
    </style>

    <!-- Tiêu đề nhóm trong form / màn hình -->
    <style name="TextAppearance.QLPT.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/qlpt_text</item>
    </style>

    <!-- Tiêu đề thẻ -->
    <style name="TextAppearance.QLPT.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/qlpt_text</item>
    </style>

    <!-- Nội dung -->
    <style name="TextAppearance.QLPT.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/qlpt_text_secondary</item>
    </style>

    <!-- Phụ chú -->
    <style name="TextAppearance.QLPT.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/qlpt_text_hint</item>
    </style>

    <!-- Giá tiền -->
    <style name="TextAppearance.QLPT.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/qlpt_accent</item>
    </style>

    <!-- Số liệu thống kê -->
    <style name="TextAppearance.QLPT.Stat" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/qlpt_text</item>
    </style>
</resources>
