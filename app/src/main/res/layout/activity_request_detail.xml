<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qlpt_surface"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/qlpt_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch xem phòng"
                android:textAppearance="@style/TextAppearance.QLPT.ScreenTitle" />

            <TextView
                android:id="@+id/tvRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/qlpt_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Widget.QLPT.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:padding="16dp"
                    android:textColor="@color/qlpt_text"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/qlpt_surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnReject"
            style="@style/Widget.QLPT.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Từ chối"
            android:textColor="@color/qlpt_error"
            android:minHeight="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/qlpt_error" />

        <Button
            android:id="@+id/btnApprove"
            style="@style/Widget.QLPT.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:layout_marginStart="6dp"
            android:text="Xác nhận lịch"
            android:minHeight="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnContract"
        style="@style/Widget.QLPT.Button.Accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="Tạo hợp đồng"
        android:visibility="gone"
        android:minHeight="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />
</LinearLayout>